<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaApp2.ViewModels"
        xmlns:models="using:MediaApp2.Models"
        x:Class="MediaApp2.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="🎬 Медиацентр ГУАП" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">

<Border Padding="20">
<DockPanel>
<!-- Верхняя панель с логотипом -->
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
<TextBlock Text="" FontSize="32" VerticalAlignment="Center"/>
<StackPanel>
<TextBlock Text="Медиацентр ГУАП" FontSize="24" FontWeight="Bold" Foreground="White"/>
<TextBlock Text="Система учёта техники и новостей" FontSize="12" Foreground="#ffffffcc"/>
</StackPanel>

<Panel HorizontalAlignment="Right" Width="250">
<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
<Button Content="🔄 Обновить" Command="{Binding LoadNewsCommand}"
                                Classes="PrimaryButton" Width="120"
                                IsVisible="{Binding IsLoggedIn}"/>

<Button Content="🔑 Войти"
                                Command="{Binding ShowLoginCommand}"
                                Classes="PrimaryButton" Width="120"
                                IsVisible="{Binding !IsLoggedIn}"/>

<StackPanel Orientation="Horizontal" IsVisible="{Binding IsLoggedIn}" Spacing="10">
<TextBlock Text="{Binding CurrentUser.Login}"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      FontWeight="SemiBold"/>
<Button Content="🚪 Выйти" Command="{Binding LogoutCommand}"
                                    Background="White" Foreground="#667eea" Width="80"/>
</StackPanel>
</StackPanel>
</Panel>
</StackPanel>

<!-- Вкладки -->
<Border Background="White" CornerRadius="16" Padding="20">
<TabControl SelectedIndex="{Binding SelectedTabIndex}">
<!-- Вкладка новостей -->
<TabItem Header=" Новости">
<ScrollViewer>
<StackPanel Spacing="10">
<TextBlock Text="{Binding StatusMessage}" Foreground="#667eea" FontWeight="SemiBold" Margin="0,0,0,15"/>

<ItemsControl ItemsSource="{Binding NewsFeed}">
<ItemsControl.ItemTemplate>
<DataTemplate DataType="models:VkPost">
<Border Classes="NewsCard">
<StackPanel Spacing="8">
<StackPanel Orientation="Horizontal">
<TextBlock Text="👤" FontSize="16"/>
<TextBlock Text="{Binding AuthorName}" FontWeight="Bold" Foreground="#667eea" Margin="5,0,0,0"/>
<TextBlock Text="•" Margin="10,0"/>
<TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                                 Foreground="#999"/>
</StackPanel>

<TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                              FontSize="14" Foreground="#333"/>

<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
<TextBlock Text="❤️" Foreground="#e74c3c"/>
<TextBlock Text="{Binding LikesCount}"
                                                                  Foreground="#666" Margin="5,0,0,0"/>
</StackPanel>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</ScrollViewer>
</TabItem>

<!-- Вкладка техники -->
<TabItem Header="📦 Техника" IsVisible="{Binding IsLoggedIn}">
<DockPanel>
<!-- Кнопки управления -->
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                       Spacing="10" Margin="0,15,0,0" HorizontalAlignment="Right">
<Button Content="Взять" Command="{Binding CheckoutCommand}"
                                        Classes="PrimaryButton" Width="120"/>
<Button Content="Вернуть" Command="{Binding ReturnCommand}"
                                        Classes="PrimaryButton" Width="120"/>
<Button Content="➕ Добавить" Command="{Binding OpenAddEquipmentWindowCommand}" Width="130"
        IsVisible="{Binding IsAdmin}" Classes="PrimaryButton"/>
</StackPanel>

<!-- Таблица техники -->
<DockPanel>
<!-- Панель корзины -->
<Border DockPanel.Dock="Right" Width="250" Background="#f8f9fa"
   CornerRadius="12" Padding="15" Margin="15,0,0,0">
<StackPanel Spacing="10">
<StackPanel Orientation="Horizontal">
<TextBlock Text=" Корзина" FontWeight="Bold" FontSize="16" Foreground="#667eea"/>
<TextBlock Text="{Binding CartCount}" FontWeight="Bold" Foreground="#e74c3c"
  Margin="5,0,0,0"/>
</StackPanel>

<ItemsControl ItemsSource="{Binding Cart}" MaxHeight="300">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,5"
   BoxShadow="0 2 4 #10000000">
<StackPanel>
<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>

<Button Content="🗑 Очистить" Command="{Binding ClearCartCommand}"
   Width="100" HorizontalAlignment="Center"
   Background="#f5f5f5" Foreground="#666" CornerRadius="6"/>
</StackPanel>
</Border>

<!-- Кнопки управления -->
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
   Spacing="10" Margin="0,15,0,0" HorizontalAlignment="Right">
<Button Content="Взять выбранное" Command="{Binding CheckoutCommand}"
Classes="PrimaryButton" Width="140"/>
<Button Content="Вернуть" Command="{Binding ReturnCommand}"
Classes="PrimaryButton" Width="100"/>
<Button Content="➕ Добавить" Command="{Binding OpenAddEquipmentWindowCommand}"
Classes="PrimaryButton" Width="130" IsVisible="{Binding IsAdmin}"/>
</StackPanel>

<!-- Таблица с тегами -->
<DataGrid ItemsSource="{Binding EquipmentList}"
 AutoGenerateColumns="False"
 IsReadOnly="True"
 SelectionMode="Extended">
<DataGrid.Columns>
<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>

<DataGridTemplateColumn Header="Теги" Width="200">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<ItemsControl ItemsSource="{Binding TagList}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<WrapPanel/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border CornerRadius="12" Padding="6,3" Margin="2"
   Background="{Binding Converter={StaticResource TagToColorConverter}}">
<TextBlock Text="{Binding}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

<DataGridTemplateColumn Header="Статус" Width="120">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal" Spacing="5">
<Ellipse Width="8" Height="8" VerticalAlignment="Center">
<Ellipse.Fill>
<SolidColorBrush Color="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
</Ellipse.Fill>
</Ellipse>
<TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"/>
</StackPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

<DataGridTextColumn Header="Дата" Binding="{Binding CheckoutDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
</DataGrid.Columns>
</DataGrid>
</DockPanel>
</DockPanel>
</TabItem>

<!-- Вкладка бронирования помещения -->
<TabItem Header=" 🏢 Бронирование">
<DockPanel>
<!-- Календарь и форма бронирования -->
<Border DockPanel.Dock="Top" Background="#f8f9fa" CornerRadius="12" Padding="20" Margin="0,0,0,20">
<StackPanel Spacing="15">
<TextBlock Text="📅 Календарь бронирования" FontSize="18" FontWeight="Bold" Foreground="#667eea"/>

<!-- Навигация по месяцам -->
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
<Button Content="◀ Пред." Command="{Binding PreviousMonthCommand}" Width="100" Classes="PrimaryButton"/>
<TextBlock Text="{Binding SelectedCalendarDate, StringFormat='{}{0:MMMM yyyy}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
<Button Content="След. ▶" Command="{Binding NextMonthCommand}" Width="100" Classes="PrimaryButton"/>
</StackPanel>

<!-- Сетка календаря -->
<Border Background="White" CornerRadius="8" Padding="10" Margin="0,10">
<Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,*">
<!-- Дни недели -->
<TextBlock Grid.Row="0" Grid.Column="0" Text="Пн" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="1" Text="Вт" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="Ср" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="3" Text="Чт" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="4" Text="Пт" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="5" Text="Сб" FontWeight="Bold" Foreground="#e74c3c" HorizontalAlignment="Center" Padding="5"/>
<TextBlock Grid.Row="0" Grid.Column="6" Text="Вс" FontWeight="Bold" Foreground="#e74c3c" HorizontalAlignment="Center" Padding="5"/>

<!-- Дни месяца -->
<ItemsControl Grid.Row="1" Grid.ColumnSpan="7" ItemsSource="{Binding CalendarDays}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<UniformGrid Columns="7"/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Margin="2" CornerRadius="4" Padding="5" 
        Background="{Binding HasBookings, Converter={StaticResource BoolToColorConverter}}"
        BorderBrush="{Binding IsToday, Converter={StaticResource BoolToBorderConverter}}"
        BorderThickness="2" Cursor="Hand">
<Border.ToolTip>
<ToolTip Content="{Binding BookingInfo}"/>
</Border.ToolTip>
<StackPanel HorizontalAlignment="Center">
<TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
<TextBlock Text="{Binding DayName}" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
<Border IsVisible="{Binding HasBookings}" Background="#e74c3c" CornerRadius="3" Padding="3,1" Margin="0,2">
<TextBlock Text="{Binding BookedHours} ч." FontSize="9" Foreground="White" HorizontalAlignment="Center"/>
</Border>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Grid>
</Border>

<!-- Информация о выбранном дне -->
<Border IsVisible="{Binding SelectedDayBooking, Converter={StaticResource NotNullConverter}}" 
        Background="#e8f4fd" CornerRadius="8" Padding="15" Margin="0,10">
<StackPanel>
<TextBlock Text="📋 Бронирования на выбранный день:" FontWeight="Bold" Margin="0,0,0,10"/>
<ItemsControl ItemsSource="{Binding RoomBookings}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Background="White" CornerRadius="4" Padding="8" Margin="0,2">
<StackPanel>
<TextBlock Text="{Binding UserName}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Purpose}" FontSize="12" Foreground="#666"/>
<TextBlock Text="{Binding StartTime, StringFormat='{}{0:hh:mm}'} - {Binding EndTime, StringFormat='{}{0:hh:mm}'}" FontSize="11" Foreground="#999"/>
<Border CornerRadius="4" Padding="4,2" Margin="0,2" 
        Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
        HorizontalAlignment="Left">
<TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/>
</Border>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</Border>

<Separator Margin="0,10"/>

<!-- Форма бронирования -->
<TextBlock Text="📝 Забронировать помещение" FontSize="16" FontWeight="Bold" Foreground="#667eea"/>

<!-- Переключатель: пользователь / гость -->
<StackPanel Orientation="Horizontal" Spacing="15">
<CheckBox Content="Я гость (без аккаунта)" IsChecked="{Binding IsGuestBooking}"/>
</StackPanel>

<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
<!-- Дата и время -->
<TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" VerticalAlignment="Center" Margin="0,0,10,0"/>
<DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding BookingDate}" Margin="0,0,10,0"/>

<TextBlock Grid.Row="1" Grid.Column="0" Text="Время начала:" VerticalAlignment="Center" Margin="0,10,10,0"/>
<TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding BookingStartTime}" Margin="0,10,10,0"/>

<TextBlock Grid.Row="2" Grid.Column="0" Text="Время окончания:" VerticalAlignment="Center" Margin="0,10,10,0"/>
<TimePicker Grid.Row="2" Grid.Column="1" SelectedTime="{Binding BookingEndTime}" Margin="0,10,10,0"/>

<!-- Поля для гостей -->
<TextBlock Grid.Row="3" Grid.Column="0" Text="Ваше имя:" VerticalAlignment="Center" Margin="0,10,10,0" IsVisible="{Binding IsGuestBooking}"/>
<TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" 
Text="{Binding GuestName}" 
Watermark="Введите ваше имя"
Margin="0,10,10,0"
IsVisible="{Binding IsGuestBooking}"/>

<TextBlock Grid.Row="4" Grid.Column="0" Text="Email/Телефон:" VerticalAlignment="Center" Margin="0,10,10,0" IsVisible="{Binding IsGuestBooking}"/>
<StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsGuestBooking}">
<TextBox Text="{Binding GuestEmail}" Watermark="Email" Width="150"/>
<TextBox Text="{Binding GuestPhone}" Watermark="Телефон" Width="150"/>
</StackPanel>

<!-- Цель бронирования -->
<TextBlock Grid.Row="0" Grid.Column="2" Text="Цель:" VerticalAlignment="Center" Margin="10,0,0,0"/>
<TextBox Grid.Row="1" Grid.Column="2" Grid.RowSpan="4" 
Text="{Binding BookingPurpose}" 
Watermark="Например: Съёмка интервью"
Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="10,0,0,0"/>
</Grid>

<Button Content="📝 Забронировать" Command="{Binding BookRoomCommand}" 
Classes="PrimaryButton" Width="200" HorizontalAlignment="Right"/>
</StackPanel>
</Border>

<!-- Список всех бронирований -->
<DataGrid ItemsSource="{Binding RoomBookings}"
  AutoGenerateColumns="False"
  IsReadOnly="True"
  SelectionMode="Single"
  SelectedItem="{Binding SelectedBooking}">
<DataGrid.Columns>
<DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="*"/>
<DataGridTemplateColumn Header="Тип" Width="80">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding IsGuest, Converter={StaticResource BoolToIconConverter}}" FontSize="12"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
<DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat='{}{0:hh:mm}'}" Width="80"/>
<DataGridTextColumn Header="Окончание" Binding="{Binding EndTime, StringFormat='{}{0:hh:mm}'}" Width="80"/>
<DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="*"/>
<DataGridTemplateColumn Header="Статус" Width="120">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Border CornerRadius="12" Padding="8,4" 
Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
<TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
</Border>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>

<!-- Кнопки управления -->
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
   Spacing="10" Margin="0,15,0,0" HorizontalAlignment="Right">
<Button Content="✅ Подтвердить" Command="{Binding ApproveBookingCommand}"
Classes="PrimaryButton" Width="140"
IsVisible="{Binding IsAdmin}"/>
<Button Content="❌ Отклонить" Command="{Binding RejectBookingCommand}"
Classes="PrimaryButton" Width="120"
IsVisible="{Binding IsAdmin}"/>
<Button Content="🔄 Обновить" Command="{Binding LoadBookingsCommand}"
Width="100" Background="#f5f5f5" Foreground="#666"/>
</StackPanel>
</DockPanel>
</TabItem>
</TabControl>
</Border>
</DockPanel>
</Border>
</Window>
