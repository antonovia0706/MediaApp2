<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaApp2.ViewModels"
        xmlns:models="using:MediaApp2.Models"
        xmlns:controls="using:Avalonia.Controls"
        x:Class="MediaApp2.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="🎬 Медиацентр ГУАП" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        xmlns:views="using:MediaApp2.Views">

<Border Padding="20">
<DockPanel>
<!-- Верхняя панель с логотипом -->
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
<TextBlock Text="" FontSize="32" VerticalAlignment="Center"/>
<StackPanel>
<TextBlock Text="Медиацентр ГУАП" FontSize="24" FontWeight="Bold" Foreground="White"/>
<TextBlock Text="Система учёта техники и новостей" FontSize="12" Foreground="#ffffffcc"/>
</StackPanel>

<Panel HorizontalAlignment="Right" Width="250">
<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
<Button Content="🔄 Обновить" Command="{Binding LoadNewsCommand}"
                                Classes="PrimaryButton" Width="120"
                                IsVisible="{Binding IsLoggedIn}"/>

<Button Content="🔑 Войти"
                                Command="{Binding ShowLoginCommand}"
                                Classes="PrimaryButton" Width="120"
                                IsVisible="{Binding !IsLoggedIn}"/>

<StackPanel Orientation="Horizontal" IsVisible="{Binding IsLoggedIn}" Spacing="10">
<TextBlock Text="{Binding CurrentUser.Login}"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      FontWeight="SemiBold"/>
<Button Content="🚪 Выйти" Command="{Binding LogoutCommand}"
                                    Background="White" Foreground="#667eea" Width="80"/>
</StackPanel>
</StackPanel>
</Panel>
</StackPanel>

<!-- Вкладки -->
<Border Background="White" CornerRadius="16" Padding="20">
<TabControl SelectedIndex="{Binding SelectedTabIndex}">
<!-- Вкладка новостей -->
<TabItem Header=" Новости">
<ScrollViewer>
<StackPanel Spacing="10">
<TextBlock Text="{Binding StatusMessage}" Foreground="#667eea" FontWeight="SemiBold" Margin="0,0,0,15"/>

<ItemsControl ItemsSource="{Binding NewsFeed}">
<ItemsControl.ItemTemplate>
<DataTemplate DataType="models:VkPost">
<Border Classes="NewsCard">
<StackPanel Spacing="8">
<StackPanel Orientation="Horizontal">
<TextBlock Text="👤" FontSize="16"/>
<TextBlock Text="{Binding AuthorName}" FontWeight="Bold" Foreground="#667eea" Margin="5,0,0,0"/>
<TextBlock Text="•" Margin="10,0"/>
<TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                                 Foreground="#999"/>
</StackPanel>

<TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                              FontSize="14" Foreground="#333"/>

<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
<TextBlock Text="❤️" Foreground="#e74c3c"/>
<TextBlock Text="{Binding LikesCount}"
                                                                  Foreground="#666" Margin="5,0,0,0"/>
</StackPanel>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</ScrollViewer>
</TabItem>

<!-- Вкладка техники -->
<TabItem Header="📦 Техника" IsVisible="{Binding IsLoggedIn}">
<DockPanel>
<!-- Кнопки управления -->
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                       Spacing="10" Margin="0,15,0,0" HorizontalAlignment="Right">
<Button Content="Взять" Command="{Binding CheckoutCommand}"
                                        Classes="PrimaryButton" Width="120"/>
<Button Content="Вернуть" Command="{Binding ReturnCommand}"
                                        Classes="PrimaryButton" Width="120"/>
<Button Content="➕ Добавить" Command="{Binding OpenAddEquipmentWindowCommand}" Width="130"
        IsVisible="{Binding IsAdmin}" Classes="PrimaryButton"/>
</StackPanel>

<!-- Таблица техники -->
<DockPanel>
<!-- Панель корзины -->
<Border DockPanel.Dock="Right" Width="250" Background="#f8f9fa"
   CornerRadius="12" Padding="15" Margin="15,0,0,0">
<StackPanel Spacing="10">
<StackPanel Orientation="Horizontal">
<TextBlock Text=" Корзина" FontWeight="Bold" FontSize="16" Foreground="#667eea"/>
<TextBlock Text="{Binding CartCount}" FontWeight="Bold" Foreground="#e74c3c"
  Margin="5,0,0,0"/>
</StackPanel>

<ItemsControl ItemsSource="{Binding Cart}" MaxHeight="300">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,5"
   BoxShadow="0 2 4 #10000000">
<StackPanel>
<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>

<Button Content="🗑 Очистить" Command="{Binding ClearCartCommand}"
   Width="100" HorizontalAlignment="Center"
   Background="#f5f5f5" Foreground="#666" CornerRadius="6"/>
</StackPanel>
</Border>

<!-- Таблица с тегами -->
<DataGrid ItemsSource="{Binding EquipmentList}"
 AutoGenerateColumns="False"
 IsReadOnly="True"
 SelectionMode="Extended">
<DataGrid.Columns>
<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>

<DataGridTemplateColumn Header="Теги" Width="200">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<ItemsControl ItemsSource="{Binding TagList}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<WrapPanel/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border CornerRadius="12" Padding="6,3" Margin="2"
   Background="{Binding Converter={StaticResource TagToColorConverter}}">
<TextBlock Text="{Binding}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

<DataGridTemplateColumn Header="Статус" Width="120">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal" Spacing="5">
<Ellipse Width="8" Height="8" VerticalAlignment="Center">
<Ellipse.Fill>
<SolidColorBrush Color="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
</Ellipse.Fill>
</Ellipse>
<TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"/>
</StackPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

<DataGridTextColumn Header="Дата" Binding="{Binding CheckoutDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
</DataGrid.Columns>
</DataGrid>
</DockPanel>
</DockPanel>
</TabItem>

<!-- Вкладка бронирования помещения -->
<TabItem Header=" 🏢 Бронирование">
<DockPanel>
<!-- Заголовок и легенда -->
<Border DockPanel.Dock="Top" Background="#f8f9fa" CornerRadius="12" Padding="20" Margin="0,0,0,20">
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
<StackPanel Spacing="15">
<TextBlock Text="📅 Календарь бронирования студии" FontSize="20" FontWeight="Bold" Foreground="#667eea"/>

<!-- Легенда статусов -->
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
<StackPanel Orientation="Horizontal" Spacing="5">
<Ellipse Width="12" Height="12" Fill="#27ae60"/>
<TextBlock Text="Свободно" VerticalAlignment="Center" FontSize="12"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="5">
<Ellipse Width="12" Height="12" Fill="#f1c40f"/>
<TextBlock Text="Частично занято" VerticalAlignment="Center" FontSize="12"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="5">
<Ellipse Width="12" Height="12" Fill="#e74c3c"/>
<TextBlock Text="Занято полностью" VerticalAlignment="Center" FontSize="12"/>
</StackPanel>
</StackPanel>

<!-- Блок статистики -->
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0">
<Border Background="White" CornerRadius="12" Padding="20,15" BoxShadow="0 4 8 #20000000">
<StackPanel HorizontalAlignment="Center">
<TextBlock Text="Всего броней" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
<TextBlock Text="{Binding TotalBookings}" FontSize="24" FontWeight="Bold" Foreground="#667eea" HorizontalAlignment="Center"/>
</StackPanel>
</Border>
<Border Background="White" CornerRadius="12" Padding="20,15" BoxShadow="0 4 8 #20000000">
<StackPanel HorizontalAlignment="Center">
<TextBlock Text="Свободные дни" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
<TextBlock Text="{Binding FreeDays}" FontSize="24" FontWeight="Bold" Foreground="#27ae60" HorizontalAlignment="Center"/>
</StackPanel>
</Border>
<Border Background="White" CornerRadius="12" Padding="20,15" BoxShadow="0 4 8 #20000000">
<StackPanel HorizontalAlignment="Center">
<TextBlock Text="Занятые дни" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
<TextBlock Text="{Binding BusyDays}" FontSize="24" FontWeight="Bold" Foreground="#e74c3c" HorizontalAlignment="Center"/>
</StackPanel>
</Border>
</StackPanel>

<!-- Навигация по месяцам -->
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0">
<Button Content="◀" Command="{Binding PreviousMonthCommand}" Width="40" Classes="PrimaryButton" FontSize="16"/>
<TextBlock Text="{Binding SelectedCalendarDate, StringFormat='{}{0:MMMM yyyy}'}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" MinWidth="150" TextAlignment="Center"/>
<Button Content="▶" Command="{Binding NextMonthCommand}" Width="40" Classes="PrimaryButton" FontSize="16"/>
</StackPanel>

<!-- Сетка календаря -->
<Border Background="White" CornerRadius="12" Padding="15" Margin="0,15" BoxShadow="0 4 12 #30000000">
<Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,*">
<!-- Дни недели -->
<TextBlock Grid.Row="0" Grid.Column="0" Text="Пн" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#667eea"/>
<TextBlock Grid.Row="0" Grid.Column="1" Text="Вт" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#667eea"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="Ср" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#667eea"/>
<TextBlock Grid.Row="0" Grid.Column="3" Text="Чт" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#667eea"/>
<TextBlock Grid.Row="0" Grid.Column="4" Text="Пт" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#667eea"/>
<TextBlock Grid.Row="0" Grid.Column="5" Text="Сб" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#e74c3c"/>
<TextBlock Grid.Row="0" Grid.Column="6" Text="Вс" FontWeight="Bold" HorizontalAlignment="Center" Padding="10,8" Foreground="#e74c3c"/>

<!-- Дни месяца -->
<ItemsControl Grid.Row="1" Grid.ColumnSpan="7" ItemsSource="{Binding CalendarDays}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<UniformGrid Columns="7"/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Margin="3" CornerRadius="8" Padding="8" 
        Background="{Binding DayStatus, Converter={StaticResource DayStatusToColorConverter}}"
        BorderThickness="{Binding IsToday, Converter={StaticResource BoolToBorderConverter}}"
        BorderBrush="#667eea"
        Cursor="Hand"
        controls:ToolTip.Tip="{Binding BookingInfo}"
        Tapped="OnCalendarDayTapped"
        DataContext="{Binding}">
    <Border.Styles>
        <Style Selector="Border:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#80ffffff"/>
        </Style>
    </Border.Styles>
<StackPanel HorizontalAlignment="Center" Spacing="2">
<TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" 
           Foreground="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}, ConverterParameter=inverted}"/>
<TextBlock Text="{Binding DayName}" FontSize="10" Foreground="#666" HorizontalAlignment="Center" IsVisible="{Binding IsCurrentMonth}"/>
<Border IsVisible="{Binding HasBookings}" Background="#ffffff30" CornerRadius="4" Padding="4,2" Margin="0,2">
<TextBlock Text="{Binding BookedHours} ч." FontSize="10" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
</Border>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Grid>
</Border>

<!-- Кнопка забронировать -->
<Button Content="📝 Забронировать студию" Command="{Binding BookRoomCommand}" 
Classes="PrimaryButton" Width="250" HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="14" Padding="15,10"/>
</StackPanel>
</ScrollViewer>
</Border>

<!-- Список всех бронирований -->
<DataGrid ItemsSource="{Binding RoomBookings}"
  AutoGenerateColumns="False"
  IsReadOnly="True"
  SelectionMode="Single"
  SelectedItem="{Binding SelectedBooking}">
<DataGrid.Columns>
<DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="*"/>
<DataGridTemplateColumn Header="Тип" Width="80">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding IsGuest, Converter={StaticResource BoolToIconConverter}}" FontSize="12"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
<DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat='{}{0:hh:mm}'}" Width="80"/>
<DataGridTextColumn Header="Окончание" Binding="{Binding EndTime, StringFormat='{}{0:hh:mm}'}" Width="80"/>
<DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="*"/>
<DataGridTemplateColumn Header="Статус" Width="120">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Border CornerRadius="12" Padding="8,4" 
Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
<TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
</Border>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>

<!-- Кнопки управления -->
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
   Spacing="10" Margin="0,15,0,0" HorizontalAlignment="Right">
<Button Content="✅ Подтвердить" Command="{Binding ApproveBookingCommand}"
Classes="PrimaryButton" Width="140"
IsVisible="{Binding IsAdmin}"/>
<Button Content="❌ Отклонить" Command="{Binding RejectBookingCommand}"
Classes="PrimaryButton" Width="120"
IsVisible="{Binding IsAdmin}"/>
<Button Content="🔄 Обновить" Command="{Binding LoadBookingsCommand}"
Width="100" Background="#f5f5f5" Foreground="#666"/>
</StackPanel>
</DockPanel>
</TabItem>
</TabControl>
</Border>
</DockPanel>
</Border>
</Window>
