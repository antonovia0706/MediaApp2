<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaApp2.ViewModels"
        x:Class="MediaApp2.Views.AddEquipmentView"
        x:DataType="vm:AddEquipmentViewModel"
        Title="➕ Добавить технику" Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        x:Name="AddEquipmentWindow">

	<Border Padding="20">
		<Border Background="White" CornerRadius="16" Padding="25"
                BoxShadow="0 10 30 #20000000">
			<ScrollViewer>
				<StackPanel Spacing="15">
					<!-- Заголовок -->
					<TextBlock Text="Новая техника" FontSize="20" FontWeight="Bold"
                              Foreground="#667eea" HorizontalAlignment="Center"/>

					<!-- Название -->
					<StackPanel Spacing="5">
						<TextBlock Text="Название *" FontWeight="SemiBold"/>
						<TextBox Text="{Binding Name}" Watermark="Например: Камера Sony A7 IV"
                                Classes="ModernTextBox"/>
					</StackPanel>

					<!-- Описание -->
					<StackPanel Spacing="5">
						<TextBlock Text="Описание" FontWeight="SemiBold"/>
						<TextBox Text="{Binding Description}" Watermark="Краткое описание оборудования..."
                                Classes="ModernTextBox" AcceptsReturn="True" MinHeight="80"/>
					</StackPanel>

					<!-- Теги -->
					<StackPanel Spacing="5">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Теги" FontWeight="SemiBold"/>
							<Button Content="️ Управление" Command="{Binding OpenTagManagerCommand}"
								   Width="100" HorizontalAlignment="Right" Margin="10,0,0,0"
								   Background="Transparent" Foreground="#667eea" BorderThickness="0"/>
						</StackPanel>

						<Border CornerRadius="10" Padding="10" Background="#fafafa" BorderThickness="1" BorderBrush="#ddd">
							<StackPanel Spacing="8">
								<!-- Выбранные теги -->
								<TextBlock Text="Выбранные:" FontSize="11" Foreground="#999"/>
								<ItemsControl ItemsSource="{Binding SelectedTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Content="{Binding Name}"
												   Background="{Binding Color}" Foreground="White"
												   CornerRadius="15" Padding="8,4" Margin="2"
												   BorderThickness="0" Cursor="Hand" FontSize="11"
												   Command="{Binding $parent[Window].DataContext.RemoveTagFromSelectedCommand, x:DataType=vm:AddEquipmentViewModel}"
												   CommandParameter="{Binding .}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!-- Доступные теги -->
								<TextBlock Text="Доступные:" FontSize="11" Foreground="#999"/>
								<ItemsControl ItemsSource="{Binding AvailableTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Content="{Binding Name}"
												   Background="{Binding Color}" Foreground="White" Opacity="0.6"
												   CornerRadius="15" Padding="8,4" Margin="2"
												   BorderThickness="0" Cursor="Hand" FontSize="11"
												   Command="{Binding $parent[Window].DataContext.AddTagFromAvailableCommand, x:DataType=vm:AddEquipmentViewModel}"
												   CommandParameter="{Binding .}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- Фотография -->
					<StackPanel Spacing="5">
						<TextBlock Text="Фотография" FontWeight="SemiBold"/>
						<Border CornerRadius="10" BorderThickness="1" BorderBrush="#ddd"
                               Padding="15" Background="#fafafa">
							<StackPanel Spacing="10">
								<!-- Превью фото -->
								<Image Height="150" Width="150" HorizontalAlignment="Center"
                                       IsVisible="{Binding PhotoPath, Converter={StaticResource NotNullConverter}}"
                                       Source="{Binding PhotoPath}"/>

								<!-- Кнопка выбора -->
								<Button Content="📷 Выбрать фото" Command="{Binding SelectPhotoCommand}"
                                       Classes="PrimaryButton" Width="200" HorizontalAlignment="Center"/>

								<!-- Путь к файлу -->
								<TextBlock Text="{Binding PhotoPath}" FontSize="10" Foreground="#999"
                                          TextWrapping="Wrap" HorizontalAlignment="Center"
                                          IsVisible="{Binding PhotoPath, Converter={StaticResource NotNullConverter}}"/>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- Статус -->
					<TextBlock Text="{Binding StatusMessage}" Foreground="#e74c3c"
                              FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>

					<!-- Кнопки -->
					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
						<Button Content="Отмена" Command="{Binding CancelCommand}" Width="100"
                               Background="#f5f5f5" Foreground="#333"/>
						<Button Content="💾 Сохранить" Command="{Binding SaveCommand}" Width="120"
                               Classes="PrimaryButton"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Border>
</Window>