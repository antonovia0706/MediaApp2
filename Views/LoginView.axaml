<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaApp2.ViewModels"
        x:Class="MediaApp2.Views.LoginView"
        x:DataType="vm:LoginViewModel"
        Title="Авторизация" Width="400" Height="450"
        WindowStartupLocation="CenterScreen">

	<Border Padding="30">
		<Border Background="White" CornerRadius="20" Padding="30"
                BoxShadow="0 10 30 #20000000">
			<StackPanel Spacing="20" VerticalAlignment="Center">
				<!-- Логотип -->
				<StackPanel HorizontalAlignment="Center">
					<TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center"/>
					<TextBlock Text="Медиацентр ГУАП" FontSize="20" FontWeight="Bold"
                              Foreground="#667eea" HorizontalAlignment="Center" Margin="0,10,0,0"/>
					<TextBlock Text="Вход в систему" FontSize="14" Foreground="#999"
                              HorizontalAlignment="Center"/>
				</StackPanel>

				<!-- Поля ввода -->
				<StackPanel Spacing="15">
					<TextBox Text="{Binding Login}"
                             Watermark="Логин"
                             Classes="ModernTextBox"
                             Padding="15,12"
                             CornerRadius="10"
                             BorderThickness="0"
                             Background="#f5f5f5"/>

					<TextBox Text="{Binding Password}"
                             Watermark="Пароль"
                             PasswordChar="*"
                             Classes="ModernTextBox"
                             Padding="15,12"
                             CornerRadius="10"
                             BorderThickness="0"
                             Background="#f5f5f5"/>
				</StackPanel>

				<!-- Сообщение об ошибке -->
				<TextBlock Text="{Binding ErrorMessage}"
                          Foreground="#e74c3c"
                          FontSize="12"
                          TextWrapping="Wrap"
                          HorizontalAlignment="Center"/>

				<!-- Кнопка входа -->
				<Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        Classes="PrimaryButton"
                        Padding="20,12"
                        CornerRadius="10"
                        HorizontalAlignment="Stretch"/>
			</StackPanel>
		</Border>
	</Border>
</Window>